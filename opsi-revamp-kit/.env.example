# =====================================================================================================
# Opsi revamp - environment inventory (EVERY variable the kit reads). Copy per component:
#   collectors      -> /etc/opsi/ingest.env          (chmod 600, owner opsi-ingest)
#   API modules     -> merged into the existing Opsi API env / secrets
#   copilot-runtime -> /etc/opsi/copilot-runtime.env
#   compose stacks  -> /etc/opsi/revamp.env, /etc/opsi/openmetadata.env
# NEVER commit filled-in copies. Prefer rendering secrets from AWS Secrets Manager at boot
# (docs/deployments.md "Secrets"). Values below are placeholders or safe defaults.
# =====================================================================================================

# ----------------------------------------------------------------------------- common / AWS
AWS_REGION=us-west-2
OPSI_TENANT_ID=default-lab                      # tenant label written into bronze rows (single-tenant: one value)

# ----------------------------------------------------------------------------- collectors: storage
OPSI_ARCHIVE_BUCKET=                            # approved bucket name (no s3:// prefix)
OPSI_ARCHIVE_PREFIX=raw
OPSI_QUARANTINE_PREFIX=quarantine
OPSI_KMS_KEY_ID=                                # key ARN/alias -> SSE-KMS; empty -> SSE-S3 (then relax the bucket policy)
OPSI_LOCAL_ARCHIVE_DIR=                         # LAB ONLY: write "S3" objects into this local folder instead
INGEST_CLASSIFICATION=internal-confidential     # data classification label stamped on every row/object

# ----------------------------------------------------------------------------- collectors: state
OPSI_STATE_BACKEND=sqlite                       # sqlite (single host) | postgres (multi host)
WORKER_STATE_DB=/var/lib/opsi-ingest/state.sqlite3
OPSI_STATE_DATABASE_URL=                        # when backend=postgres (role opsi_ingest_writer)

# ----------------------------------------------------------------------------- collectors: windows
INGEST_WINDOW_MINUTES=5                         # must divide 1440; DO NOT change after first commit without the runbook
INGEST_LAG_SECONDS=120                          # wait for late indexing at the source before a window is "closed"
INGEST_INITIAL_LOOKBACK_MINUTES=30              # first run only
INGEST_MAX_WINDOWS_PER_RUN=6                    # bounds catch-up work per run
INGEST_FINAL_RESCAN_AFTER_MINUTES=30            # one final re-scan per window for late data (0 disables)
INGEST_MIN_SPLIT_SECONDS=30                     # smallest sub-window when a source cap is hit
INGEST_PART_MAX_ROWS=5000                       # rows per Parquet part
INGEST_MESSAGE_MAX_CHARS=4000
INGEST_PAYLOAD_MAX_BYTES=65536                  # larger payloads are truncated and flagged
INGEST_REDACTION_LEVEL=strict                   # strict = secrets + PII, standard = secrets only
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5

# ----------------------------------------------------------------------------- collectors: index stage
DATABASE_URL=                                   # curated PostgreSQL sink (role opsi_ingest_writer); empty = no PG sink
INDEX_MAX_ATTEMPTS=8                            # then dead-letter (python -m opsi_ingest requeue-dead ...)
CURATED_MAX_SAMPLES_PER_SIGNATURE=3
OPENSEARCH_URL=                                 # optional Opsi-owned operational index (https outside localhost)
OPENSEARCH_INDEX=opsi-incidents                 # must start with opsi-
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_CA_CERTS=

# ----------------------------------------------------------------------------- source: Elasticsearch
ELASTIC_URL=https://REPLACE-elastic-endpoint:9200   # never embed credentials in the URL
ELASTIC_INDEX_PATTERN=logs-*
ELASTIC_TIMESTAMP_FIELD=@timestamp
ELASTIC_API_KEY=                                # preferred; role with read + view_index_metadata on the pattern
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
ELASTIC_CA_CERTS=                               # path to corporate CA bundle if TLS uses a private CA
ELASTIC_PAGE_SIZE=1000
ELASTIC_MAX_DOCS_PER_WINDOW=200000              # exceeding it splits the window (never truncates)
ELASTIC_QUERY_FILTER_JSON=                      # e.g. {"terms":{"log.level":["error","ERROR","fatal"]}}
ELASTIC_SOURCE_INCLUDES=                        # e.g. @timestamp,message,log.level,service.name,host.name,trace.id

# ----------------------------------------------------------------------------- source: Dynatrace Problems API v2 (classic)
DYNATRACE_ENV_URL=https://REPLACE.live.dynatrace.com   # SaaS env URL (Managed: https://<host>/e/<env-id>)
DYNATRACE_API_TOKEN=                            # classic API token, scope problems.read
DYNATRACE_PROBLEMS_PAGE_SIZE=500                # API maximum
DYNATRACE_PROBLEMS_SELECTOR=                    # e.g. managementZones("Opsi")
DYNATRACE_PROBLEMS_FIELDS=                      # e.g. +evidenceDetails,+impactAnalysis (bigger payloads)

# ----------------------------------------------------------------------------- source: Dynatrace Grail (platform)
DYNATRACE_PLATFORM_URL=https://REPLACE.apps.dynatrace.com
DYNATRACE_AUTH_MODE=oauth                       # oauth (client credentials, auto-refresh) | platform_token
DYNATRACE_OAUTH_TOKEN_URL=https://sso.dynatrace.com/sso/oauth2/token
DYNATRACE_OAUTH_CLIENT_ID=
DYNATRACE_OAUTH_CLIENT_SECRET=
DYNATRACE_OAUTH_SCOPE=storage:logs:read storage:buckets:read
DYNATRACE_OAUTH_RESOURCE=                       # urn:dtaccount:<account-uuid> if your setup requires it
DYNATRACE_PLATFORM_TOKEN=                       # only for DYNATRACE_AUTH_MODE=platform_token
DYNATRACE_GRAIL_DQL=fetch logs | filter in(loglevel, {"ERROR", "WARN", "SEVERE", "FATAL"})
DYNATRACE_GRAIL_MAX_RECORDS=50000               # per (sub)window; exceeding it splits the window
DYNATRACE_GRAIL_POLL_BUDGET_SECONDS=180
DYNATRACE_GRAIL_SCAN_LIMIT_GBYTES=0             # 0 = tenant default; -1 = unlimited (cost!)

# ----------------------------------------------------------------------------- API modules: identity
OPSI_ENV=dev                                    # dev | lab | staging | prod
OPSI_AUTH_MODE=oidc                             # oidc | existing (reuse Opsi auth adapter) | dev (dev/lab only)
OIDC_ISSUER=https://REPLACE-idp/                # must equal the token's iss exactly (trailing slash matters)
OIDC_AUDIENCE=api://opsi                        # the API audience your IdP puts in access tokens
OIDC_JWKS_URL=https://REPLACE-idp/.well-known/jwks.json
OIDC_ALGORITHMS=RS256,ES256
OIDC_LEEWAY_SECONDS=60
OIDC_USER_CLAIM=sub                             # Entra ID: oid is more stable than sub across apps
OIDC_TENANT_CLAIM=                              # empty -> single tenant OPSI_DEFAULT_TENANT_ID
OIDC_ROLES_CLAIM=groups
OPSI_DEFAULT_TENANT_ID=default
OPSI_GROUP_ROLE_MAP_JSON={"opsi-sre":["investigator"],"opsi-leads":["approver"],"opsi-admins":["admin"]}
OPSI_ROLE_SERVICE_SCOPE_JSON={}                 # e.g. {"investigator":["checkout","payments"],"approver":["*"]}
OPSI_DEV_USER=dev-user
OPSI_DEV_ROLES=investigator
OPSI_APPROVAL_FOUR_EYES=false                   # true: requester cannot approve own actions

# ----------------------------------------------------------------------------- API modules: database
OPSI_API_DATABASE_URL=                          # login that is a member of opsi_app (NOT owner/superuser)
OPSI_DB_POOL_MIN=1
OPSI_DB_POOL_MAX=10
OPSI_DB_STATEMENT_TIMEOUT_MS=15000
OPSI_DB_SET_ROLE=                               # e.g. opsi_app when the login is broader than needed

# ----------------------------------------------------------------------------- API modules: attachments / voice
OPSI_ATTACHMENTS_BUCKET=
OPSI_ATTACHMENTS_PREFIX=chat-attachments
OPSI_ATTACHMENTS_KMS_KEY_ID=
OPSI_ATTACHMENTS_MAX_BYTES=10485760
OPSI_ATTACHMENTS_ALLOWED_MIME=text/plain,text/csv,application/json,application/pdf,image/png,image/jpeg
OPSI_ATTACHMENTS_UPLOAD_TTL_S=300
OPSI_ATTACHMENTS_DOWNLOAD_TTL_S=60
OPSI_ATTACHMENTS_SCAN_MODE=guardduty            # guardduty | none-lab (refused in prod)
OPSI_VOICE_ENABLED=false

# ----------------------------------------------------------------------------- API modules: LLM via Portkey -> Bedrock
PORTKEY_API_KEY=
PORTKEY_BASE_URL=                               # self-hosted gateway URL, e.g. https://portkey-gw.corp.example/v1
PORTKEY_PROVIDER=                               # Model Catalog provider slug, e.g. @bedrock-prod
PORTKEY_CONFIG=                                 # OR a Portkey config id (routing/fallback/guardrails)
LLM_MODEL=                                      # Bedrock model / inference-profile id as enabled in your account
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TEMPERATURE=0.1
LLM_REQUEST_TIMEOUT_S=120
LLM_STREAM_USAGE=true                           # set false if the gateway rejects stream_options
EMBEDDING_MODEL=                                # only for OPSI_VECTOR_ENABLED=true
OPSI_VECTOR_ENABLED=false

# ----------------------------------------------------------------------------- API modules: agent budgets
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_COST_UNITS=50
AGENT_MAX_SECONDS=120
AGENT_MAX_LLM_TURNS=6
OPSI_COPILOT_AGENT_IDS=opsi-investigator

# ----------------------------------------------------------------------------- API modules: retrieval backends
SEARCH_ELASTIC_URL=                             # existing log cluster (read-only key)
SEARCH_ELASTIC_API_KEY=
SEARCH_ELASTIC_CA_CERTS=
SEARCH_ELASTIC_INDEX_ALLOWLIST=logs-*
SEARCH_ELASTIC_TENANT_INDEX_MAP_JSON={}         # {"tenant-a":["logs-tenant-a-*"]}
SEARCH_ELASTIC_TIMESTAMP_FIELD=@timestamp
SEARCH_ELASTIC_SERVICE_FIELD=service.name
SEARCH_ELASTIC_MESSAGE_FIELD=message
SEARCH_ELASTIC_SOURCE_FIELDS=@timestamp,message,log.level,service.name,host.name,trace.id
SEARCH_OPENSEARCH_URL=
SEARCH_OPENSEARCH_INDEX=opsi-incidents
SEARCH_OPENSEARCH_USERNAME=
SEARCH_OPENSEARCH_PASSWORD=
OPENMETADATA_URL=                               # e.g. http://127.0.0.1:8585 (no /api suffix)
OPENMETADATA_BOT_TOKEN=                         # JWT of a read-only OpenMetadata bot
OPENMETADATA_CA_CERTS=

# ----------------------------------------------------------------------------- telemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SDK_DISABLED=false
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.2
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
TRACELOOP_TRACE_CONTENT=false                   # OpenLLMetry captures prompts BY DEFAULT - keep false
OPSI_TELEMETRY_SALT=                            # random string; pseudonymises user ids in spans
OTLP_EXPORT_ENDPOINT=                           # collector -> backend, e.g. https://<env>.live.dynatrace.com/api/v2/otlp
OTLP_EXPORT_AUTH_HEADER=                        # e.g. "Api-Token dt0c01...." (Dynatrace) or "ApiKey ..." (Elastic)
DEPLOYMENT_ENVIRONMENT=lab

# ----------------------------------------------------------------------------- copilot-runtime (Node)
RUNTIME_HOST=127.0.0.1
RUNTIME_PORT=4000
RUNTIME_BASE_PATH=/api/copilotkit
OPSI_AGENT_BASE_URL=http://127.0.0.1:8000/api/v2/agents
RUNTIME_FORWARD_HEADERS=authorization,x-request-id,traceparent,tracestate   # add cookie ONLY if Opsi auth is cookie-based
RUNTIME_REQUIRE_AUTH_HEADERS=authorization,cookie
RUNTIME_ALLOW_SUGGESTIONS=false
RUNTIME_MAX_BODY_BYTES=2097152
RUNTIME_SSE_KEEPALIVE_SECONDS=15
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
SCARF_ANALYTICS=false                           # for npm install: disables install-time analytics ping

# ----------------------------------------------------------------------------- operations / tests
MIGRATE_DATABASE_URL=                           # migrator login for scripts/migrate.sh
TEST_DATABASE_URL=                              # throwaway DB for pytest -m integration (never shared/prod)
OPSI_ALERT_TOPIC_ARN=                           # optional SNS topic for opsi-notify@.service
