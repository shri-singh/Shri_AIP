# Bronze collector for one source, e.g. opsi-collect@elastic.service
# Install: sudo cp opsi-collect@.service opsi-collect@.timer /etc/systemd/system/ && sudo systemctl daemon-reload
#          sudo systemctl enable --now opsi-collect@elastic.timer
# Logs:    journalctl -u opsi-collect@elastic -n 50 --no-pager
# A oneshot unit never overlaps with itself: if a run is still going when the timer fires, the
# timer waits - no flock needed (cron needs flock).
[Unit]
Description=Opsi bronze collector (%i)
After=network-online.target
Wants=network-online.target
OnFailure=opsi-notify@%N.service

[Service]
Type=oneshot
User=opsi-ingest
Group=opsi-ingest
WorkingDirectory=/opt/opsi-revamp-kit/services/ingestion
EnvironmentFile=/etc/opsi/ingest.env
Environment=PYTHONUNBUFFERED=1 WORKER_STATE_DB=/var/lib/opsi-ingest/state.sqlite3
ExecStart=/opt/opsi-revamp-kit/.venv/bin/python -m opsi_ingest collect --source %i
TimeoutStartSec=20min
MemoryMax=2G
CPUQuota=150%
# hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/opsi-ingest
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
