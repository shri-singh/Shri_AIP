# Copy to .env on EC2, chmod 600. NEVER commit secrets.
AWS_REGION=us-west-2
OPSI_ARCHIVE_BUCKET=replace-with-approved-unique-bucket
OPSI_TENANT_ID=default-lab
WORKER_STATE_DB=.state/checkpoints.sqlite3
# Retain 2 min lag to avoid incomplete source windows; overlap previous minute
INGEST_LOOKBACK_MINUTES=10
INGEST_LAG_SECONDS=120
INGEST_OVERLAP_SECONDS=60
INGEST_WINDOW_MAX_MINUTES=10
INGEST_BATCH_SIZE=500
# Optional curated sink: set DATABASE_URL for non-empty PostgreSQL output
DATABASE_URL=
# Elastic
ELASTIC_URL=https://replace-elastic-endpoint:9200
ELASTIC_INDEX_PATTERN=logs-*
ELASTIC_TIMESTAMP_FIELD=@timestamp
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
# Dynatrace Problems API v2 (SaaS/Managed base URL)
DYNATRACE_ENV_URL=https://example.live.dynatrace.com
DYNATRACE_API_TOKEN=
# Dynatrace Grail environment app URL + platform OAuth bearer token (not Classic API token)
DYNATRACE_PLATFORM_URL=https://example.apps.dynatrace.com
DYNATRACE_PLATFORM_BEARER_TOKEN=
DYNATRACE_GRAIL_RESULT_LIMIT=5000
# OpenSearch querying; an isolated index owned by Opsi, NOT raw catalog index
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=opsi-incidents
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
# Future / not wired directly by this starter
PORTKEY_API_KEY=
BEDROCK_MODEL_ID=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
